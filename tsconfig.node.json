{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    // The repo scripts are plain ESM, type-checked through their JSDoc.
    "allowJs": true,
    "checkJs": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite", "vite.config.ts", "vitest.config.ts", "scripts"]
}
